# Copy this file to .env in the server directory before running the app.
# Example: cp .env.example.template .env
# Never commit the real .env file or any production credentials.

NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-your-local-db-password
DB_NAME=bank_management_system

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOGIN_RATE_LIMIT=20
BACKUP_ROOT=./bank-management-system-backups
